{
  "name": "easymatch-bd",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "scripts": {
    "kill-ports": "npx kill-port 4100 4101",
    "predev": "npm run kill-ports && npm run build -w @easymatch/shared",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npx kill-port 4100 && npm run dev -w @easymatch/web",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:mobile": "npm run start:go -w @easymatch/mobile",
    "dev:mobile:live": "npm run start:go:live -w @easymatch/mobile",
    "dev:mobile:ngrok": "npm run start:go:ngrok -w @easymatch/mobile",
    "dev:mobile:tunnel": "npm run start:tunnel -w @easymatch/mobile",
    "tunnel:status": "node scripts/tunnel.mjs status",
    "tunnel:stop": "node scripts/tunnel.mjs stop",
    "tunnel": "node scripts/tunnel.mjs start",
    "stop": "npm run kill-ports",
    "build": "npm run build:hostinger-web",
    "build:all": "npm run build -w @easymatch/shared && npm run build -w @easymatch/api && npm run build -w @easymatch/web",
    "build:railway-api": "node scripts/railway-api-build.mjs",
    "build:railway-web": "node scripts/railway-web-build.mjs",
    "test:railway-db": "node scripts/railway-test-db.mjs",
    "prebuild:hostinger-web": "node scripts/hostinger-prebuild.mjs",
    "build:hostinger-web": "npm run build -w @easymatch/shared && npm run build -w @easymatch/web && node scripts/hostinger-postbuild.mjs",
    "build:hostinger-api": "npm run build -w @easymatch/shared && npm run build:hostinger -w @easymatch/api && node scripts/hostinger-api-postbuild.mjs",
    "install:hostinger": "npm ci --include=optional",
    "start": "node server.js",
    "lint": "npm run lint -w @easymatch/web && npm run lint -w @easymatch/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "wait-on": "^9.0.10"
  }
}
