# Hostname only (Next allowedDevOrigins). Full URL is OK — next.config normalizes it.
# easymatchbd.ngrok.dev is always allowed in dev; set this for extra tunnels:
# NGROK_DEV_ORIGIN=https://easymatchbd.ngrok.dev

# Leave unset to proxy /api/v1 → http://127.0.0.1:4101 in dev.
# NEXT_PUBLIC_API_URL=
