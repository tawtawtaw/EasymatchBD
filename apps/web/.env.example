# Local dev with ngrok (https://easymatchbd.ngrok.dev → web :4100)
# Leave NEXT_PUBLIC_API_URL unset — Next.js rewrites /api/v1 to the local API on :4101.
NGROK_DEV_ORIGIN=easymatchbd.ngrok.dev

# WhatsApp support FAB + contact links (web only).
# Prefer WHATSAPP_SUPPORT_NUMBER on Railway — read at runtime (no rebuild after changes).
WHATSAPP_SUPPORT_NUMBER=+8801XXXXXXXXX
# Or for local dev / build-time inlining:
# NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=+8801XXXXXXXXX
# WHATSAPP_SUPPORT_ENABLED=false

# Production / Railway only:
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1

# SSLCommerz footer payment-methods banner — enable only after official gateway approval.
# Uses apps/web/public/images/sslcommerz-payment-banner.png unless overridden:
# NEXT_PUBLIC_SSLCOMMERZ_GATEWAY_APPROVED=true
# NEXT_PUBLIC_SSLCOMMERZ_BANNER_URL=https://...
