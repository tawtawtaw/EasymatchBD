# API base URL — required on a physical device (localhost is the phone itself).
# Android emulator default in dev: http://10.0.2.2:4101/api/v1
# Physical device on same Wi‑Fi: http://YOUR_PC_LAN_IP:4101/api/v1
# Remote testing: https://your-ngrok-host.ngrok.dev/api/v1
#
# You do NOT need this file if you use npm run start:go:live (Railway) or start:go:ngrok.
# See .env.live.example for production test URLs.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4101/api/v1

# Website base URL for membership upgrade (opens in browser)
# EasymatchBD web runs on port 4100 (not 3000)
# Android emulator: http://10.0.2.2:4100
# Physical device: http://YOUR_PC_LAN_IP:4100
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:4100

# Video call WebView URL — must be HTTPS on a physical device (WebRTC/camera).
# Use your ngrok web tunnel when testing calls on a real phone:
# EXPO_PUBLIC_VIDEO_CALL_WEB_URL=https://easymatchbd.ngrok.dev
# Falls back to EXPO_PUBLIC_WEB_URL when unset (OK on emulator/localhost only).

# WhatsApp support (same number as web NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER)
EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=01XXXXXXXXX
# EXPO_PUBLIC_WHATSAPP_SUPPORT_ENABLED=false
