# Copy to .env when testing Expo Go against Railway production (no local API/web).
# Or run: npm run start:go:live  (uses these URLs without copying this file)
#
# cp .env.live.example .env   # macOS/Linux
# copy .env.live.example .env # Windows

EXPO_PUBLIC_API_URL=https://api.easymatchbd.com/api/v1
EXPO_PUBLIC_WEB_URL=https://easymatchbd.com
EXPO_PUBLIC_VIDEO_CALL_WEB_URL=https://easymatchbd.com

# Optional — same as web WhatsApp support
# EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=+8801730321717
