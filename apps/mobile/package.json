{
  "name": "@easymatch/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --clear --port 8081",
    "start:go": "node scripts/expo-start.mjs local start --go --clear --port 8081",
    "start:go:live": "node scripts/expo-start.mjs live start --go --clear --port 8081",
    "start:go:ngrok": "node scripts/expo-start.mjs ngrok start --go --clear --port 8081",
    "start:tunnel": "expo start --dev-client --tunnel --clear --port 8081",
    "start:tunnel:go": "node scripts/expo-start.mjs ngrok start --go --tunnel --clear --port 8081",
    "android": "expo run:android",
    "build:dev": "node scripts/verify-google-services.mjs && eas build --platform android --profile development",
    "build:preview": "node scripts/verify-google-services.mjs && eas build --platform android --profile preview",
    "build:preview-live": "node scripts/verify-google-services.mjs && eas build --platform android --profile preview-live",
    "build:production": "node scripts/verify-google-services.mjs && eas build --platform android --profile production",
    "bump:android": "node scripts/bump-android-version.mjs",
    "ios": "expo run:ios",
    "eas-build-pre-install": "node scripts/verify-google-services.mjs",
    "eas-build-post-install": "cd ../.. && npm run build -w @easymatch/shared"
  },
  "dependencies": {
    "@easymatch/shared": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
