# Local API port (web dev proxy targets 4101 when NEXT_PUBLIC_API_URL is unset).
PORT=4101
NODE_ENV=development
# Comma-separated when sharing via ngrok alongside local dev:
# CORS_ORIGIN=https://easymatchbd.ngrok.dev,http://localhost:4100,http://192.168.0.43:4100
CORS_ORIGIN=http://localhost:4100
# Supabase — Railway / IPv4 networks (recommended for production deploys):
# Use the SHARED pooler (Supavisor) from Supabase Dashboard → Connect → Transaction pooler.
# Do NOT use db.[ref].supabase.co:6543 on Railway — that dedicated pooler is IPv6-only unless you buy the IPv4 add-on.
# DATABASE_URL=postgresql://postgres.jrecnorpwmdlpbkffmng:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=30
# DIRECT_URL=postgresql://postgres.jrecnorpwmdlpbkffmng:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30
#
# Local / IPv6-capable hosts only (often fails on Windows — use pooler URLs above instead):
# DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.jrecnorpwmdlpbkffmng.supabase.co:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.jrecnorpwmdlpbkffmng.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.jrecnorpwmdlpbkffmng:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=30
DIRECT_URL=postgresql://postgres.jrecnorpwmdlpbkffmng:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

# Local Docker alternative (use the same URL for both variables)
# DATABASE_URL=postgresql://easymatch:easymatch_dev@localhost:5433/easymatch?schema=public
# DIRECT_URL=postgresql://easymatch:easymatch_dev@localhost:5433/easymatch?schema=public
# Upstash: Dashboard → Redis → your database → Connect → TCP → copy the rediss:// URL.
# If you see ENOTFOUND / ECONNRESET, refresh this URL from the dashboard or use local Docker:
#   npm run db:up
#   REDIS_URL=redis://localhost:6379
# Pure local dev without Redis (OTP/cache in memory for this process only):
# REDIS_URL=memory
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-ENDPOINT.upstash.io:6379

JWT_SECRET=change-me-in-production-use-a-long-random-string
# Access token lifetime. Defaults to TRUSTED_DEVICE_DAYS when unset.
JWT_EXPIRES_IN=30d
# OTP-free return visits on the same device after first OTP sign-in.
TRUSTED_DEVICE_DAYS=30

OTP_TTL_SECONDS=300
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=900

# Railway / staging only: force-hide OTP in API responses while console SMS is active.
# EXPOSE_OTP_IN_RESPONSE=false
# When SMS_PROVIDER=console (default), devOtp is returned automatically in production.

# Local file uploads (dev). Files stored under apps/api/uploads/
UPLOAD_DIR=uploads

# Storage backend: local (disk) or supabase (private bucket via API)
# STORAGE_BACKEND=local
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy equivalent: SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=profile-media
# Alias also supported: SUPABASE_BUCKET=profile-media

# Comma-separated BD mobiles for staff OTP sign-in (normalized 8801…)
VERIFICATION_OFFICER_PHONES=01700000001
SUPER_ADMIN_PHONES=01700000002
MARRIAGE_CONSULTANT_PHONES=

# Legacy email allowlist (optional staff profile email; sign-in uses phones above)
VERIFICATION_OFFICER_EMAILS=officer@example.com
SUPER_ADMIN_EMAILS=admin@example.com
# Public web URL for guest invite links (defaults to CORS_ORIGIN)
WEB_PUBLIC_URL=http://localhost:4100
# ngrok: WEB_PUBLIC_URL=https://easymatchbd.ngrok.dev

# SSLCommerz (sandbox store nextg6a380d174d2e5 — set password from merchant panel)
SSLCOMMERZ_STORE_ID=nextg6a380d174d2e5
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# LiveKit — required for multi-party calls and family guest invites
# Sign up at https://cloud.livekit.io or self-host; create a project and paste credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
